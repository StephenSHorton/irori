{
  "about": "The loopback API golden scenario (crates/api/tests/api_golden.rs, tools/goldens/api_golden_test.go). Both sides start a fresh Core with two live sessions alpha (A) and beta (B), serve their own api.Server over it, and run these steps in order. {name} is a variable: device, port, token, person, keyA, keyB, sessA, sessB, cwd, pid, personId, devicePub, plus the ones saved by steps. req: an HTTP request (auth false = no bearer token). open/read/close: an NDJSON stream; read takes the next n lines that are not keepalives, or every line up to and including the first of type until, or every line until drain ms pass without one; save [i, key] takes a key of line i (-1: the last). act: a direct service call. needs: a service Rust does not have yet (the step is recorded, and skipped by the Rust replay). ignore: top-level JSON keys both sides drop before comparing.",
  "steps": [
    {"id": "health", "req": {"method": "GET", "path": "/v1/health", "auth": false}},
    {"id": "no-token", "req": {"method": "GET", "path": "/v1/device", "auth": false}},
    {"id": "wrong-token", "req": {"method": "GET", "path": "/v1/device", "headers": {"Authorization": "Bearer nope"}}},
    {"id": "basic-auth", "req": {"method": "GET", "path": "/v1/device", "headers": {"Authorization": "Basic {token}"}}},
    {"id": "origin", "req": {"method": "GET", "path": "/v1/health", "auth": false, "headers": {"Origin": ""}}},
    {"id": "bad-host", "req": {"method": "GET", "path": "/v1/device", "headers": {"Host": "evil.example:{port}"}}},
    {"id": "localhost-host", "req": {"method": "GET", "path": "/v1/device", "headers": {"Host": "LOCALHOST:{port}"}}},
    {"id": "post-device", "req": {"method": "POST", "path": "/v1/device"}},
    {"id": "put-members", "req": {"method": "PUT", "path": "/v1/members"}},
    {"id": "post-unauth", "req": {"method": "POST", "path": "/v1/tools/agents", "auth": false}},
    {"id": "no-route", "req": {"method": "GET", "path": "/v1/nope"}},
    {"id": "no-route-unauth", "req": {"method": "GET", "path": "/v1/nope", "auth": false}},
    {"id": "agents", "req": {"method": "GET", "path": "/v1/agents"}},
    {"id": "events-limit-0", "req": {"method": "GET", "path": "/v1/events?limit=0"}},
    {"id": "events-limit-x", "req": {"method": "GET", "path": "/v1/events?limit=x"}},
    {"id": "events-none", "req": {"method": "GET", "path": "/v1/events?kind=message.sent"}},
    {"id": "devices", "req": {"method": "GET", "path": "/v1/devices"}, "needs": "mesh"},
    {"id": "pair-join-get", "req": {"method": "GET", "path": "/v1/pair/join"}},
    {"id": "pair-status-post", "req": {"method": "POST", "path": "/v1/pair/status"}},

    {"id": "attach-none", "req": {"method": "GET", "path": "/v1/attach"}},
    {"id": "attach-both", "req": {"method": "GET", "path": "/v1/attach?session=x&member=y"}},
    {"id": "attach-slash", "req": {"method": "GET", "path": "/v1/attach?session=a%2Fb"}},
    {"id": "attach-unknown", "req": {"method": "GET", "path": "/v1/attach?session=nope"}},
    {"id": "attach-bad-member", "req": {"method": "GET", "path": "/v1/attach?member=nope"}},
    {"id": "attach-post", "req": {"method": "POST", "path": "/v1/attach"}},
    {"id": "open-a", "open": {"stream": "a", "path": "/v1/attach?session={sessA}&mod=0.4.1"}},
    {"id": "a-hello", "read": {"stream": "a", "until": "inbox"}, "save": {"attachA": [0, "attachSecret"]}},
    {"id": "open-b", "open": {"stream": "b", "path": "/v1/attach?session={sessB}&mod=0.2.0"}},
    {"id": "b-hello", "read": {"stream": "b", "until": "inbox"}, "save": {"attachB": [0, "attachSecret"]}},

    {"id": "delivered-no-caller", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "body": "{}"}},
    {"id": "delivered-member-header", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Member": "nope"}, "body": "{}"}},
    {"id": "delivered-both", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}", "X-Irori-Member": "x"}, "body": "{}"}},
    {"id": "delivered-no-token", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{}"}},
    {"id": "delivered-blank", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "  \n "}},
    {"id": "delivered-array", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "[1]"}},
    {"id": "delivered-bad-json", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":"}},
    {"id": "delivered-type", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":5}"}},
    {"id": "delivered-unknown-token", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":\"[irori-wake:nope]\"}"}},
    {"id": "deliveries-bogus", "req": {"method": "POST", "path": "/v1/deliveries/bogus", "body": "{}"}},
    {"id": "deliveries-get", "req": {"method": "GET", "path": "/v1/deliveries/delivered"}},

    {"id": "send-b-to-a", "act": {"do": "send", "from": "{keyB}", "fromName": "beta", "to": "{keyA}", "text": "hello <alpha> & co"}},
    {"id": "a-deliver", "read": {"stream": "a", "until": "deliver"}, "save": {"wakeA": [-1, "token"]}},
    {"id": "delivered", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":\"{wakeA}\"}"}},
    {"id": "engaged", "req": {"method": "POST", "path": "/v1/deliveries/engaged", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":\"{wakeA}\",\"turnId\":\"turn-1\"}"}},
    {"id": "inbox-a", "req": {"method": "GET", "path": "/v1/inbox", "headers": {"X-Irori-Attach": "{attachA}"}}},
    {"id": "inbox-a-all", "req": {"method": "GET", "path": "/v1/inbox?all=1&limit=1000", "headers": {"X-Irori-Attach": "{attachA}"}}},
    {"id": "turn-ended", "req": {"method": "POST", "path": "/v1/deliveries/turn-ended", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":\"{wakeA}\",\"turnId\":\"turn-1\"}"}},
    {"id": "inbox-a-after", "req": {"method": "GET", "path": "/v1/inbox?all=true", "headers": {"X-Irori-Attach": "{attachA}"}}},
    {"id": "inbox-limit", "req": {"method": "GET", "path": "/v1/inbox?limit=-2", "headers": {"X-Irori-Attach": "{attachA}"}}},
    {"id": "inbox-no-caller", "req": {"method": "GET", "path": "/v1/inbox"}},

    {"id": "policy", "req": {"method": "GET", "path": "/v1/policy"}},
    {"id": "policy-no-composer", "req": {"method": "POST", "path": "/v1/policy", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"mode\":\"open\"}"}},
    {"id": "policy-bad-mode", "req": {"method": "POST", "path": "/v1/policy", "headers": {"X-Irori-Attach": "{attachA}", "X-Irori-Origin": "composer"}, "body": "{\"mode\":\"bogus\"}"}},
    {"id": "policy-type", "req": {"method": "POST", "path": "/v1/policy", "headers": {"X-Irori-Attach": "{attachA}", "X-Irori-Origin": "composer"}, "body": "{\"block\":[\"a\",2]}"}},
    {"id": "policy-allowlist", "req": {"method": "POST", "path": "/v1/policy", "headers": {"X-Irori-Attach": "{attachA}", "X-Irori-Origin": "composer"}, "body": "{\"MODE\":\"allowlist\",\"allow\":[\" x \",\"x\",\"\",null],\"block\":null}"}},
    {"id": "policy-everyone", "req": {"method": "POST", "path": "/v1/policy", "headers": {"X-Irori-Attach": "{attachA}", "X-Irori-Origin": "composer"}, "body": "{}"}},
    {"id": "events-policy", "req": {"method": "GET", "path": "/v1/events?kind=policy.set&limit=5"}},

    {"id": "members-empty", "req": {"method": "POST", "path": "/v1/members", "body": "{\"name\":\"  \"}"}},
    {"id": "members-control", "req": {"method": "POST", "path": "/v1/members", "body": "{\"name\":\"a\\u0007b\"}"}},
    {"id": "members-long-session", "req": {"method": "POST", "path": "/v1/members", "body": "{\"name\":\"g\",\"session\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}"}},
    {"id": "members-get", "req": {"method": "GET", "path": "/v1/members"}},
    {"id": "join", "req": {"method": "POST", "path": "/v1/members", "body": "{\"name\":\" grok one \",\"session\":\"grok-session-1\"}"}, "save": {"memberSecret": ["memberSecret"], "memberKey": ["memberKey"]}},
    {"id": "agents-joined", "req": {"method": "GET", "path": "/v1/agents"}},
    {"id": "open-m", "open": {"stream": "m", "path": "/v1/attach?member={memberSecret}"}},
    {"id": "m-hello", "read": {"stream": "m", "until": "inbox"}},
    {"id": "agents-streaming", "req": {"method": "GET", "path": "/v1/agents"}},
    {"id": "inbox-m", "req": {"method": "GET", "path": "/v1/inbox", "headers": {"X-Irori-Member": "{memberSecret}"}}},
    {"id": "send-a-to-m", "act": {"do": "send", "from": "{keyA}", "fromName": "alpha", "to": "{memberKey}", "text": "ping\tgrok line"}},
    {"id": "m-deliver", "read": {"stream": "m", "until": "deliver"}},
    {"id": "delivered-member", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Member": "{memberSecret}"}, "body": "{\"token\":\"x\"}"}},
    {"id": "rejoin", "req": {"method": "POST", "path": "/v1/members", "body": "{\"name\":\"grok two\",\"session\":\"grok-session-1\"}"}, "save": {"memberSecret2": ["memberSecret"]}},
    {"id": "inbox-old-member", "req": {"method": "GET", "path": "/v1/inbox", "headers": {"X-Irori-Member": "{memberSecret}"}}},
    {"id": "close-m", "close": "m"},

    {"id": "tools-bad-client", "req": {"method": "GET", "path": "/v1/tools?client=gpt"}},
    {"id": "tools-get-post", "req": {"method": "GET", "path": "/v1/tools/agents"}},
    {"id": "tools-no-caller", "req": {"method": "POST", "path": "/v1/tools/agents", "body": "{}"}},
    {"id": "tools-grok", "req": {"method": "GET", "path": "/v1/tools?client=grok"}, "needs": "tools"},
    {"id": "tools-unknown", "req": {"method": "POST", "path": "/v1/tools/nope", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{}"}, "needs": "tools"},
    {"id": "tools-args-array", "req": {"method": "POST", "path": "/v1/tools/agents", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"args\":[1]}"}, "needs": "tools"},
    {"id": "tools-body-array", "req": {"method": "POST", "path": "/v1/tools/agents", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "[]"}, "needs": "tools"},
    {"id": "tools-inbox", "req": {"method": "POST", "path": "/v1/tools/inbox", "headers": {"X-Irori-Attach": "{attachB}"}, "body": "{\"args\":null}"}, "needs": "tools"},

    {"id": "events-agent", "req": {"method": "GET", "path": "/v1/events?kind=message.sent"}},
    {"id": "events-person", "req": {"method": "GET", "path": "/v1/events?kind=message.&kind=&limit=1", "headers": {"X-Irori-Person": "{person}"}}},
    {"id": "events-wrong-person", "req": {"method": "GET", "path": "/v1/events", "headers": {"X-Irori-Person": "nope"}}},
    {"id": "events-device", "req": {"method": "GET", "path": "/v1/events?kind=message.sent&device=someone-else"}},
    {"id": "stream-bad-since", "req": {"method": "GET", "path": "/v1/events/stream?since=x:y"}},
    {"id": "stream-dup-since", "req": {"method": "GET", "path": "/v1/events/stream?since={device}:1,{device}:2"}},
    {"id": "stream-wrong-person", "req": {"method": "GET", "path": "/v1/events/stream", "headers": {"X-Irori-Person": "nope"}}},
    {"id": "open-e", "open": {"stream": "e", "path": "/v1/events/stream?kinds=message.,policy.set&since={device}:0"}},
    {"id": "e-replay", "read": {"stream": "e", "drain": 1500}},
    {"id": "open-p", "open": {"stream": "p", "path": "/v1/events/stream?kinds=message.sent", "headers": {"X-Irori-Person": "{person}"}}},
    {"id": "send-b-to-a-2", "act": {"do": "send", "from": "{keyB}", "fromName": "beta", "to": "{keyA}", "text": "second <irori-message> look-alike"}},
    {"id": "e-live", "read": {"stream": "e", "n": 1}},
    {"id": "p-live", "read": {"stream": "p", "n": 1}},
    {"id": "a-second", "read": {"stream": "a", "until": "deliver"}},
    {"id": "close-e", "close": "e"},
    {"id": "close-p", "close": "p"},

    {"id": "open-a2", "open": {"stream": "a2", "path": "/v1/attach?session={sessA}&mod=0.4.1"}},
    {"id": "a2-hello", "read": {"stream": "a2", "until": "inbox"}, "save": {"attachA2": [0, "attachSecret"]}},
    {"id": "a-superseded", "read": {"stream": "a", "until": "superseded"}},
    {"id": "old-secret", "req": {"method": "POST", "path": "/v1/deliveries/delivered", "headers": {"X-Irori-Attach": "{attachA}"}, "body": "{\"token\":\"x\"}"}},
    {"id": "new-secret", "req": {"method": "GET", "path": "/v1/inbox", "headers": {"X-Irori-Attach": "{attachA2}"}}},

    {"id": "timeline-no-agent", "req": {"method": "GET", "path": "/v1/timeline"}},
    {"id": "timeline-bad-before", "req": {"method": "GET", "path": "/v1/timeline?agent={keyA}&before=yesterday"}},
