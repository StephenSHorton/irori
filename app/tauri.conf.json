{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irori",
  "mainBinaryName": "irori",
  "version": "0.0.0",
  "identifier": "com.stephenshorton.irori",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost irori: http://irori.localhost",
        "img-src": "'self' data: blob: irori: http://irori.localhost",
        "media-src": "'self' blob: irori: http://irori.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
